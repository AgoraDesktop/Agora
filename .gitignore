# Build output — never versioned
/build-prefix/

# Agent/runtime state
/.reasonix/
# Machine-local agent notes: recorded DPI, host quirks. Never upstream.
/AGENTS.md

# Local logs
*.log

# The supplied XFWM theme (Greybird) — somebody else's GPL/CC-BY-SA art, read at
# runtime only. It must never be committed, so it is ignored here as well as in
# libagora-app, where the resolver's copy lives (libagora-app/themes/, also
# ignored). Provenance: libagora-app/themes/PROVENANCE.
/theme-greybird/

# The Flat-Remix icon theme (GPL-3) — read at run time, never committed. demo/flat-remix-accent.sh
# renders it into build-prefix/share/icons/Flat-Remix-Accent with the folders in Agora's accent.
/flat-remix-master/

# The interface builder's own build tree (it is built like a component, not installed).
/builder/build/
